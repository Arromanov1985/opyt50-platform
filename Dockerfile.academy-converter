# Separate offline job image. Do not add to the web application container.
FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg poppler-utils libreoffice-impress fonts-liberation fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'Pillow>=11.3,<14'
WORKDIR /srv
COPY app/academy_conversion.py ./app/academy_conversion.py
COPY scripts/convert_academy_media.py ./scripts/convert_academy_media.py
RUN useradd -r -u 10001 converter && mkdir /input /output && chown 10001:10001 /output
ENV PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
ENTRYPOINT ["python", "-m", "scripts.convert_academy_media"]
