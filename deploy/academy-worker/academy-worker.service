[Unit]
Description=STAZHNO Academy bounded private media worker
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/stazhno/opyt50-platform
EnvironmentFile=%h/.config/stazhno/academy-worker.env
ExecStart=%h/stazhno/.venv/bin/python -m scripts.academy_worker --mode all --limit 1
UMask=0077
# One invocation may scan an image, a rich original and up to 30 derivatives.
# Allow slow bounded scans, conversion, storage retries and database work.
TimeoutStartSec=6h
Restart=no
