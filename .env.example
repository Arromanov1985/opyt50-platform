# DO NOT COMMIT real passwords, database URLs, SMTP secrets or MFA seeds.
# Configure production secrets only in the hosting provider's secret/environment UI.

# Runtime mode. Use production on the real public service.
OPYT50_ENV=development
OPYT50_DB_PATH=./data/opyt50.db

# Public origin used in verification/password-reset links and WebAuthn RP binding.
# IMPORTANT: keep this on the actual live App Platform URL until stazhno.ru
# is attached to the application and serves the same production deployment.
OPYT50_PUBLIC_URL=https://arromanov1985-opyt50-platform-fdd8.twc1.net

# Session cookies become Secure automatically for production/HTTPS, but keep
# this explicit in production so a later configuration change cannot weaken it.
OPYT50_COOKIE_SECURE=0

# Swagger/OpenAPI are useful locally and should be disabled on production.
OPYT50_ENABLE_DOCS=1

# Optional Host-header allowlist. In production include the public domain and
# every legitimate platform/health-check hostname before enabling this.
# Current working host: arromanov1985-opyt50-platform-fdd8.twc1.net
OPYT50_ALLOWED_HOSTS=

# PostgreSQL TLS. Local development may leave this empty.
# Production minimum: require. Preferred after installing the provider CA:
# verify-full (and provide sslrootcert in DATABASE_URL/provider configuration).
OPYT50_DB_SSLMODE=

# Preview gate (only for a temporary demo stand, not the public production site).
OPYT50_PREVIEW_USERNAME=review
OPYT50_PREVIEW_PASSWORD=
OPYT50_PREVIEW_SEED_DEMO=0

# Administrator MFA. Production must not use "off".
# Preferred production mode: totp (Authenticator app). Generate a random
# Base32 secret outside Git and store it only in the hosting provider secret UI.
# email remains available as a weaker fallback when TOTP cannot be used.
# Admin MFA: off | email | totp | hybrid
# hybrid prefers a registered passkey and keeps TOTP as fallback.
OPYT50_ADMIN_MFA_MODE=off
OPYT50_ADMIN_TOTP_SECRET=

# SMTP delivery. Never commit the real password.
OPYT50_SMTP_HOST=
# Timeweb working configuration for this project:
# host smtp.timeweb.ru, port 465, implicit SSL.
# OPYT50_SMTP_USER must equal OPYT50_MAIL_FROM (for example noreply@stazhno.ru).
OPYT50_SMTP_PORT=465
OPYT50_SMTP_USER=
OPYT50_SMTP_PASSWORD=
OPYT50_MAIL_FROM=
OPYT50_SMTP_SSL=1
OPYT50_SMTP_STARTTLS=0
