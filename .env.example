# DO NOT COMMIT real passwords or API keys. Configure in Timeweb Cloud's UI.
OPYT50_DB_PATH=./data/opyt50.db
# Must be 1 on an HTTPS public URL; leave 0 when testing plain HTTP locally.
OPYT50_COOKIE_SECURE=0
# Preview gate (optional locally; required for demo-seeded cloud preview).
OPYT50_PREVIEW_USERNAME=review
OPYT50_PREVIEW_PASSWORD=
# Only for the password-protected, temporary DEMO on Timeweb Cloud.
OPYT50_PREVIEW_SEED_DEMO=0

# Public URL used in verification and password-reset links.
# Example: https://your-domain.example
OPYT50_PUBLIC_URL=

# Optional production SMTP delivery. Leave OPYT50_SMTP_HOST or OPYT50_MAIL_FROM empty
# to keep safe outbox-only mode. Never commit real passwords.
OPYT50_SMTP_HOST=
OPYT50_SMTP_PORT=587
OPYT50_SMTP_USER=
OPYT50_SMTP_PASSWORD=
OPYT50_MAIL_FROM=
# Use STARTTLS on port 587 by default. For implicit TLS (usually port 465),
# set OPYT50_SMTP_SSL=1 and OPYT50_SMTP_STARTTLS=0.
OPYT50_SMTP_SSL=0
OPYT50_SMTP_STARTTLS=1
